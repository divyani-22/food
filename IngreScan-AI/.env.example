# Copy to .env and fill in. Every value is optional for local development.

# Database: leave empty to use the embedded SQLite file (data/ingrescan.db).
DATABASE_URL=
# SQLITE_PATH=

# HTTP port (default 3000; the server picks the next free port if it is busy)
# PORT=3000

# Required in production
JWT_SECRET=
OPENAI_API_KEY=
# Other OpenAI-compatible endpoint / model (defaults: https://api.openai.com/v1 and gpt-4o-mini)
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# LLM request timeout in ms (default 60000)
# LLM_TIMEOUT_MS=
# Production only: allow the built-in keyword engine when no key is set (demo mode, not a real model)
# ALLOW_LOCAL_LLM_FALLBACK=true

# Login (production). Without VITE_OAUTH_PORTAL_URL the dev server signs you in as a local user.
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# Manus Forge: LLM and file storage proxy (used instead of OPENAI_API_KEY when the key is set)
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Open Food Facts (default: https://world.openfoodfacts.org)
OPENFOODFACTS_BASE_URL=
# Caches for Open Food Facts lookups (see docs/barcode-scanning.md); leave unset for the defaults
# OFF_CACHE_HIT_TTL_SECONDS=21600
# OFF_CACHE_MISS_TTL_SECONDS=300
# OFF_CACHE_MAX_ENTRIES=500
# OFF_CACHE_DISABLED=true
# Open Prices origin and cache TTL for the alternatives price block (see docs/alternatives-market-data.md)
# OPEN_PRICES_BASE_URL=https://prices.openfoodfacts.org
# ALT_MARKET_CACHE_TTL_SECONDS=21600

# FreshGuard (Flask) service
FRESHGUARD_URL=http://127.0.0.1:5000
# Timeout of proxied FreshGuard requests in ms (default 60000)
# FRESHGUARD_TIMEOUT_MS=

# WhatsApp bot (see docs/whatsapp-bot.md)
PUBLIC_BASE_URL=
WHATSAPP_BOT_NUMBER=
WHATSAPP_PROVIDER=
WHATSAPP_TRUST_SCHEME_VARIANTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_REMINDER_CONTENT_SID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_REMINDER_LANGUAGE=en
# "off" disables the reminder scheduler; "true" adds emoji markers to bot replies
# WHATSAPP_REMINDERS=on
# WHATSAPP_USE_EMOJI=false

# Production hardening (see docs/production-hardening.md)
# Number of reverse-proxy hops to trust (X-Forwarded-For/Proto/Host). Set to 1 behind nginx/Caddy/a load balancer.
TRUST_PROXY=
# Content-Security-Policy: report-only (default; hard-boundary directives still enforced), enforce, or off
CSP_MODE=report-only
# Extra https origins (comma separated) for the CSP, e.g. a map or analytics host
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_CONNECT_SRC=
CSP_EXTRA_IMG_SRC=
# Extra origins allowed to send state-changing /api requests (the host itself and PUBLIC_BASE_URL are always allowed)
ALLOWED_ORIGINS=
# Cookie SameSite override: lax | strict | none (default none over https, lax over http)
COOKIE_SAMESITE=
# Per-IP requests per minute
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=60
RATE_LIMIT_UPLOADS_PER_MIN=600
# Logging and monitoring
LOG_LEVEL=info
# Optional: pnpm add @sentry/node, then set the DSN (loaded lazily, nothing happens when empty)
SENTRY_DSN=
# Set to 1: /readyz returns 503 when the FreshGuard service is down (default: reported only)
READYZ_REQUIRE_FRESHGUARD=
# Set to 1: exit after an uncaught exception (use with a process supervisor that restarts the app)
EXIT_ON_UNCAUGHT=
SHUTDOWN_TIMEOUT_MS=10000
